# ============ GMAIL CONNECTION ============
GMAIL_ADDR="...@gmail.com" // your address email
GMAIL_PASSWORD="" // app gmail password (not the password of your account)
GMAIL_IMAP_LINK="imap.gmail.com"
GMAIL_IMAP_PORT=993
GMAIL_SMTP_LINK="smtp.gmail.com"
GMAIL_SMTP_PORT=587

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN="" // Bot token
TELEGRAM_CHAT_ID=""

# ============ CONTEXT FOR RESPONSE ============
USER_FIRST_NAME="Prénom"
USER_LAST_NAME="Nom"
USER_ROLE="Ton poste actuel"
USER_COMPANY="Ton entreprise ou école"
USER_CITY="Ta ville (ex: Marseille)"

USER_TONE="Naturel, bienveillant, concis et pragmatique"
USER_SIGNATURE="Cordialement,\nPrénom Nom"
USER_AVAILABILITY="Disponible en semaine de 9h à 18h, préfère les échanges par mail ou visio"

USER_BIO="Passionné par .... Toujours prêt à aider sur des sujets ... (OU AUTRE)"
USER_VALUES="Efficacité, clarté, pas de blabla inutile, honnêteté"
USER_RULES="Ne jamais accepter de réunion sans ordre du jour. Toujours rester poli même en cas de refus. Répondre dans la même langue que l'expéditeur."
